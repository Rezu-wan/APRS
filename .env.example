# ============================================================================
# Payment Failure Recovery & Digital Twin API — environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# ============================================================================

# --- application -------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
# Comma-separated browser origins allowed by CORS (empty = no browser access)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- database ----------------------------------------------------------------
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://payment_app:CHANGE_ME@localhost:5432/payment_recovery
# Local development fallback (SQLite):
DATABASE_URL=sqlite:///./data/app.db

# --- authentication (API keys; one role per key) ------------------------------
# Generate real keys for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_SYSTEM=change-me-system-key
API_KEY_ADMIN=change-me-admin-key
API_KEY_SUPPORT=change-me-support-key
API_KEY_CUSTOMER=change-me-customer-key

# --- recovery policy thresholds (changeable without retraining the model) -----
RECOVERY_MIN_SAFE_PROBABILITY=0.90
RECOVERY_MAX_AMOUNT=1500
RECOVERY_MAX_PREVIOUS_FAILURES=3

# --- GenAI explanations (Stage 4; explanation ONLY — never decisions) --------
# AI_PROVIDER=mock needs no key (deterministic local provider).
# AI_PROVIDER=openai uses the OpenAI API; the key stays server-side.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=12

# --- ML artifacts --------------------------------------------------------------
MODEL_DIR=models
